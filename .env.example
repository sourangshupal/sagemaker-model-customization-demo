# AWS region for all resources (serverless customization: us-east-1, us-west-2, eu-west-1, ap-northeast-1)
AWS_REGION=us-east-1

# REQUIRED — SageMaker execution role ARN. Console-created roles include a
# /service-role/ path, e.g.:
# arn:aws:iam::<account-id>:role/service-role/AmazonSageMaker-ExecutionRole-XXXXXXXXXXXXX
# Trust must include sagemaker.amazonaws.com AND lambda.amazonaws.com
# (see README Prerequisites).
ROLE_ARN=

# Optional — separate role for the scorer Lambda. Defaults to ROLE_ARN.
# LAMBDA_ROLE_ARN=

# REQUIRED for evaluation scripts — Managed MLflow tracking server ARN, e.g.:
# arn:aws:sagemaker:us-east-1:<account-id>:mlflow-tracking-server/my-mlflow
MLFLOW_TRACKING_SERVER_ARN=

# Path to your local clone of https://github.com/aws-samples/generative-ai-on-amazon-sagemaker
WORKSHOP_DIR=~/generative-ai-on-amazon-sagemaker
